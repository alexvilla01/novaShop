# ================================================
# novaShop — configuración de producción (plantilla)
# Copia como .env en el VPS y rellena los valores.
#   cp .env.example .env && nano .env
# ================================================

# Dominio público de la tienda (Caddy emite HTTPS automático)
# Ej: DOMAIN=store.tutienda.com
DOMAIN=localhost

# PostgreSQL
POSTGRES_DB=novashop
POSTGRES_USER=novashop
# Generar: openssl rand -base64 24
POSTGRES_PASSWORD=CAMBIA-ME

# Credenciales del panel admin (/admin/login)
NS_ADMIN_USER=admin
# Generar hash bcrypt de tu contraseña:
#   cd backend && ./mvnw -q exec:java -Dexec.mainClass=mx.novashop.store.admin.HashBootstrap 2>/dev/null \
#     || python3 -c 'import bcrypt;print(bcrypt.hashpw("TU_PASSWORD".encode(),bcrypt.gensalt()).decode())'
NS_ADMIN_PASSWORD_HASH=CAMBIA-ME
# Secreto HMAC de sesiones admin — Generar: openssl rand -hex 32
NS_ADMIN_SECRET=CAMBIA-ME

# WhatsApp destino de las órdenes (formato internacional sin + ni espacios)
NS_WA_PHONE=5215512345678
